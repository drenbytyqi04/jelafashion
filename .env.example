# Copy to .env.local and fill in. Never commit real values.

# Public site URL, used for metadata, canonical URLs and emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact (until the admin panel stores these). Leave empty to show placeholders.
# WhatsApp number in international format, digits only or with +, e.g. +38349000000
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# Show /styleguide in production builds (development reference). Off by default.
NEXT_PUBLIC_ENABLE_STYLEGUIDE=

# Added in later phases:
# Phase 2: NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# Phase 4: RESEND_API_KEY, EMAIL_FROM, SHOP_NOTIFICATION_EMAIL,
#          PAYSERA_PROJECT_ID, PAYSERA_SIGN_PASSWORD, PAYSERA_TEST_MODE
# Phase 6: NEXT_PUBLIC_META_PIXEL_ID, META_CAPI_ACCESS_TOKEN, NEXT_PUBLIC_GA4_ID,
#          NEXT_PUBLIC_TIKTOK_PIXEL_ID
