# Copy to .env.local and fill in. Never commit real values.

# Public site URL, used for metadata, canonical URLs and emails. On Vercel, leave it empty
# until the domain is connected (the project's production URL is used), then set it to
# https://<domain>.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact (until the admin panel stores these). Leave empty to show placeholders.
# WhatsApp number in international format, digits only or with +, e.g. +38349000000
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# Show /styleguide in production builds (development reference). Off by default.
NEXT_PUBLIC_ENABLE_STYLEGUIDE=

# Supabase (Project Settings → API). Without these the site runs on the built-in sample
# catalog (src/lib/catalog/seed-data.ts) and the newsletter accepts but does not store.
# Both values are public by design (safe in the browser); never put the secret or
# service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://bducwcutmikztjcpqayk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_DElT-lODcLlTy5OtW9yLEw_5gGQW6j3
# Legacy alternative to the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only secrets (Vercel → Settings → Environment Variables). Never NEXT_PUBLIC_,
# never committed, never pasted into chats or tickets. ---

# Orders: Supabase secret key (sb_secret_…) or legacy service_role key. Required in
# production; without it checkout reports itself unavailable. In development orders are
# kept in .data/orders.json instead.
SUPABASE_SERVICE_ROLE_KEY=

# Emails (resend.com). Without a key, development writes every email to .data/emails/.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Jela Fashion <porosi@jelafashion.com>"
EMAIL_FROM=
# Where new orders and payment proofs are announced (the atelier's inbox)
SHOP_NOTIFICATION_EMAIL=

# Paysera card payments (paysera.com → project settings). Without these, development uses
# a local sandbox page and production hides the card option.
PAYSERA_PROJECT_ID=
PAYSERA_SIGN_PASSWORD=
# "true" while testing: payments are simulated by Paysera and nothing is charged
PAYSERA_TEST_MODE=true
# Optional: Paysera's public key (PEM, \n for line breaks) to also verify the ss2 signature
PAYSERA_PUBLIC_KEY=

# Google sign-in: "true" once the Google provider is enabled in Supabase Auth
NEXT_PUBLIC_AUTH_GOOGLE=

# Local development only (never set these in Vercel):
# JF_DEV_ADMINS=admin@example.com   emails that sign in as admin without Supabase
# JF_LOCAL_DATA=1                    run a production build on the local .data/ database (QA)

# --- Tracking. Each tag loads only after the visitor allows it in the cookie banner
# (GA4 → analytics; Meta and TikTok → marketing). Leave empty to switch a tag off. ---

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Meta (Facebook/Instagram) Pixel ID, digits only
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API (Events Manager → Settings → Generate access token). Server-only.
# Purchases are sent from the browser and the server with the same event_id, so Meta
# counts each order once.
META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager → Test events code, while checking the setup; remove afterwards
META_CAPI_TEST_EVENT_CODE=
# Optional: Graph API version (default v21.0)
META_GRAPH_VERSION=
# TikTok Pixel ID
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
